# cp .env.example .env puis renseigner. Ne jamais versionner .env.
APP_NAME=Gestion Clients

# Signature des sessions — OBLIGATOIRE — openssl rand -hex 32
SECRET_KEY=

# Chiffrement des mots de passe au repos — openssl rand -hex 32
# Sans cette clé, les secrets sont stockés EN CLAIR. À sauvegarder précieusement :
# la perdre = secrets illisibles.
ENCRYPTION_KEY=

# Compte administrateur créé au tout premier démarrage
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_REQUIRE_2FA=1      # 1 = le compte admin doit activer la 2FA dès sa 1re connexion

# Exposée sur Internet : garder ces deux-là à 1
TRUST_PROXY=1
COOKIE_SECURE=1          # cookies + HSTS : nécessite HTTPS (reverse proxy)

MAX_UPLOAD_MB=25
SESSION_HOURS=12         # durée maximale d'une session
IDLE_MINUTES=30          # déconnexion après inactivité
